by_feat$points

plot(by_feat$scores[c("PC1", "PC2")], type = "n",
     xlab = paste0("PC1 (", round(by_feat$variance$prop_var[1], 2), "\%)"),
     ylab = paste0("PC2 (", round(by_feat$variance$prop_var[2], 2), "\%)"))
