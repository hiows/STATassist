        C = 1, cv_method = "kfold", n_fold = 5, seed = 1)
tuned <- fit_svm(mtcars, outcome = "mpg", predictors = c("wt", "hp", "disp"),
                 C = c(0.5, 2, 8), cv_method = "kfold", n_fold = 5, seed = 1)
