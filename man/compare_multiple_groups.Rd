   \code{welch_test} \tab Welch's ANOVA \tab not applicable \cr
   \code{robust_test} \tab Yuen's trimmed mean ANOVA \tab not applicable \cr
   \code{kruskal_test} \tab Kruskal-Wallis \tab Friedman \cr
