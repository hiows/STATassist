lasso <- do.call(fit_elastic_net,
                 c(sim$args, list(penalty = "lasso", lambda = 0.5,
                                  cv = FALSE)))
scored <- merge(lasso$coefficients, sim$truth_term, by = "terms")
table(planted = scored$beta != 0, selected = scored$selected)

